    <color name="splash_light_top">#29A3F5</color>
    <color name="splash_light_mid">#148AE6</color>
    <color name="splash_light_bottom">#0D70CC</color>
    <color name="splash_dark_top">#0D2A49</color>
    <color name="splash_dark_mid">#081A2E</color>
    <color name="splash_dark_bottom">#03101D</color>
</resources>
