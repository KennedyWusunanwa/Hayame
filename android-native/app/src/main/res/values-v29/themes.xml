<resources>
    <style name="Theme.Hayame" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:navigationBarColor">@color/splash_bottom</item>
        <item name="android:navigationBarDividerColor">@color/splash_bottom</item>
        <item name="android:statusBarColor">@color/splash_top</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
    </style>

    <!-- Used when the app's appearance is forced light, so launch never flashes the other palette. -->
    <style name="Theme.Hayame.ForcedLight">
        <item name="android:windowBackground">@drawable/splash_window_background_light</item>
        <item name="android:navigationBarColor">@color/splash_light_bottom</item>
        <item name="android:statusBarColor">@color/splash_light_top</item>
        <item name="android:navigationBarDividerColor">@color/splash_light_bottom</item>
    </style>
    <!-- Used when the app's appearance is forced dark, so launch never flashes the other palette. -->
    <style name="Theme.Hayame.ForcedDark">
        <item name="android:windowBackground">@drawable/splash_window_background_dark</item>
        <item name="android:navigationBarColor">@color/splash_dark_bottom</item>
        <item name="android:statusBarColor">@color/splash_dark_top</item>
        <item name="android:navigationBarDividerColor">@color/splash_dark_bottom</item>
    </style>
</resources>
